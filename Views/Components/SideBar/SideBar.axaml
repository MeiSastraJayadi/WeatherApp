<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeatherApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:WeatherApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WeatherApp.SideBar"
             Design.Width="220"
             x:DataType="vm:MainViewModel">

    <local:SideBarTheme>
      <StackPanel>
        
        <local:NavButton 
          Click="Click_Nav" 
          Classes.active="{Binding IsHomeActive}"
          Icon="{StaticResource IconHome}" 
          Content="Home" />

        <local:NavButton 
          Click="Click_Nav" 
          Classes.active="{Binding IsForecastActive}"
          Icon="{StaticResource IconForecast}" 
          Content="Forecast" />

        <local:NavButton 
          Click="Click_Nav" 
          Classes.active="{Binding IsMapActive}"
          Icon="{StaticResource IconMap}" 
          Content="Map" />

        <local:NavButton 
          Click="Click_Nav"
          Classes.active="{Binding IsSettingActive}" 
          Icon="{StaticResource IconSettings}" 
          Content="Setting"/>
      </StackPanel>
    </local:SideBarTheme>
</UserControl>
