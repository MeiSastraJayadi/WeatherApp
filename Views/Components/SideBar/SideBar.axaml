<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeatherApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:WeatherApp"
             xmlns:nav="using:WeatherApp.Navigation"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WeatherApp.SideBar"
             Design.Width="220"
             x:DataType="vm:MainViewModel">

    <local:SideBarTheme>
      <StackPanel>
        
        <local:NavButton 
          Command="{Binding NavigateCommand}"
          CommandParameter="{x:Static nav:AppRoute.Home}"
          Icon="{StaticResource IconHome}" 
          Classes.active="{
            Binding Navigation.CurrentRoute, 
            Converter={StaticResource EnumEqualsConverter},
            ConverterParameter={x:Static nav:AppRoute.Home}
          }"
          Content="Home" />

        <local:NavButton 
          Command="{Binding NavigateCommand}"
          CommandParameter="{x:Static nav:AppRoute.Forecast}"
          Classes.active="{
            Binding Navigation.CurrentRoute, 
            Converter={StaticResource EnumEqualsConverter},
            ConverterParameter={x:Static nav:AppRoute.Forecast}
          }"
          Icon="{StaticResource IconForecast}" 
          Content="Forecast" />

        <local:NavButton 
          Command="{Binding NavigateCommand}"
          CommandParameter="{x:Static nav:AppRoute.Map}"
          Classes.active="{
            Binding Navigation.CurrentRoute, 
            Converter={StaticResource EnumEqualsConverter},
            ConverterParameter={x:Static nav:AppRoute.Map}
          }"
          Icon="{StaticResource IconMap}" 
          Content="Map" />

        <local:NavButton 
          Command="{Binding NavigateCommand}"
          CommandParameter="{x:Static nav:AppRoute.Settings}"
          Classes.active="{
            Binding Navigation.CurrentRoute, 
            Converter={StaticResource EnumEqualsConverter},
            ConverterParameter={x:Static nav:AppRoute.Settings}
          }"
          Icon="{StaticResource IconSettings}" 
          Content="Setting"/>
      </StackPanel>
    </local:SideBarTheme>
</UserControl>
