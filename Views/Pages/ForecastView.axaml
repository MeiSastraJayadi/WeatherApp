<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:WeatherApp.ViewModels.Pages"
             xmlns:weatherapp="using:WeatherApp"
             x:Class="WeatherApp.Views.Pages.ForecastView"
             x:DataType="vm:ForecastViewModel">
  <StackPanel Spacing="10">

      <StackPanel Margin="5 0 0 10" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Foreground="#203955" 
            Height="15" Width="15" 
            Data="{StaticResource IconPinMap}" />
          <TextBlock Foreground="#203955" FontSize="15" Text="Jakarta" />
        </StackPanel>
        <TextBlock Foreground="#45596F" FontSize="10"  Text="{Binding CurrentTime^}" />
      </StackPanel>

      <Grid ColumnDefinitions="1.5*,*" ColumnSpacing="10">
        <weatherapp:Card Grid.Column="0" Padding="0 10">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="0">
            <Image 
              Source="avares://WeatherApp/Assets/Icons/partly_cloudy.png"
              Width="150"
              Height="100"
              Stretch="Uniform"
            />
            <StackPanel VerticalAlignment="Center" Spacing="6" HorizontalAlignment="Center">
                <StackPanel 
                  Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                  <TextBlock Text="28" Foreground="#45596F" FontWeight="SemiBold" FontSize="35" />
                  <TextBlock Text="℃" Foreground="#45596F" FontWeight="SemiBold" FontSize="20" Margin="2 0 0 0 " />
                </StackPanel>
                <TextBlock TextAlignment="Center" Text="Partly Cloud" Foreground="#45596F" FontSize="15" />
            </StackPanel>
          </StackPanel>
        </weatherapp:Card>
        <weatherapp:Card Grid.Column="1" Padding="10">
          <Grid ColumnDefinitions="*,Auto">

            <StackPanel Spacing="5" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
              <TextBlock Foreground="#45596F" TextAlignment="Left" Text="High" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Left" Text="Low" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Left" Text="Humidity" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Left" Text="Wind" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Left" Text="Precipitation" FontSize="10" FontWeight="Medium" />
            </StackPanel>

            <StackPanel Spacing="5" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock Foreground="#45596F" TextAlignment="Right" Text="31" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Right" Text="22" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Right" Text="78%" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Right" Text="24 km/h" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Right" Text="10%" FontSize="10" FontWeight="Medium" />
            </StackPanel>

          </Grid>
        </weatherapp:Card>
      </Grid>

      <TextBlock Text="Next 7 Days" Foreground="#45596F" FontWeight="SemiBold" FontSize="25" Margin="0 10" />
  </StackPanel>
</UserControl>
