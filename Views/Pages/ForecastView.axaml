<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:WeatherApp.ViewModels.Pages"
             xmlns:weatherapp="using:WeatherApp"
             x:Class="WeatherApp.Views.Pages.ForecastView"
             x:DataType="vm:ForecastViewModel">
  <Grid RowSpacing="10" RowDefinitions="Auto,Auto,Auto,*">

      <StackPanel Margin="5 0 0 10" Spacing="4" Grid.Row="0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Foreground="#203955" 
            Height="15" Width="15" 
            Data="{StaticResource IconPinMap}" />
          <TextBlock Foreground="#203955" FontSize="15" Text="Jakarta" />
        </StackPanel>
        <TextBlock Foreground="#45596F" FontSize="10"  Text="{Binding CurrentTime^}" />
      </StackPanel>

      <Grid ColumnDefinitions="1.5*,*" ColumnSpacing="10" Grid.Row="1">
        <weatherapp:Card Grid.Column="0" Padding="0 10" Margin="0 0 0 8">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="0">
            <Image 
              Source="avares://WeatherApp/Assets/Icons/partly_cloudy.png"
              Width="150"
              Height="100"
              Stretch="Uniform"
            />
            <StackPanel VerticalAlignment="Center" Spacing="6" HorizontalAlignment="Center">
                <StackPanel 
                  Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                  <TextBlock Text="28" Foreground="#45596F" FontWeight="SemiBold" FontSize="35" />
                  <TextBlock Text="℃" Foreground="#45596F" FontWeight="SemiBold" FontSize="20" Margin="2 0 0 0 " />
                </StackPanel>
                <TextBlock TextAlignment="Center" Text="Partly Cloud" Foreground="#45596F" FontSize="15" />
            </StackPanel>
          </StackPanel>
        </weatherapp:Card>
        <weatherapp:Card Margin="0 0 0 8" Grid.Column="1" Padding="10">
          <Grid ColumnDefinitions="*,Auto">

            <StackPanel Spacing="5" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
              <TextBlock Foreground="#45596F" TextAlignment="Left" Text="High" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Left" Text="Low" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Left" Text="Humidity" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Left" Text="Wind" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Left" Text="Precipitation" FontSize="10" FontWeight="Medium" />
            </StackPanel>

            <StackPanel Spacing="5" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock Foreground="#45596F" TextAlignment="Right" Text="31" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Right" Text="22" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Right" Text="78%" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Right" Text="24 km/h" FontSize="10" FontWeight="Medium" />
              <TextBlock Foreground="#45596F" TextAlignment="Right" Text="10%" FontSize="10" FontWeight="Medium" />
            </StackPanel>

          </Grid>
        </weatherapp:Card>
      </Grid>

      <TextBlock Grid.Row="2" Text="Next 7 Days" Foreground="#45596F" FontWeight="SemiBold" FontSize="15" Margin="0 10 0 0" />
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Forecasts}">
          
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel></StackPanel>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="10" Background="#40ffffff" Margin="0 0 0 2" Padding="5">
                <Grid ColumnDefinitions="2*,*,*,2*">
                  <TextBlock Foreground="#45596F" FontSize="12" Grid.Column="0" Text="{Binding Day}" />
                  <Image Grid.Column="1" Source="{Binding Icon}" Width="25" Height="25" />
                  <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <TextBlock Foreground="#45596F" FontSize="12" Text="{Binding MinTemperature}" />
                    <TextBlock Foreground="#45596F" FontSize="12" Text="/" />
                    <TextBlock Foreground="#45596F" FontSize="12" Text="{Binding MaxTemperature}" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="1">
                    <PathIcon Foreground="#45596F" Width="12" Height="12" Data="{StaticResource IconDroplet}" />
                    <TextBlock Foreground="#45596F" FontSize="12" Text="{Binding Humidity}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>

        </ItemsControl>
      </ScrollViewer>

  </Grid>
</UserControl>
