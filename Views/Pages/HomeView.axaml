<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WeatherApp.ViewModels.Pages"
             xmlns:weatherapp="using:WeatherApp"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WeatherApp.Views.Pages.HomeView"
             x:DataType="vm:HomeViewModel">

    <StackPanel Spacing="10">

      <StackPanel Margin="5 0 0 0" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Foreground="#203955" 
            Height="15" Width="15" 
            Data="{StaticResource IconPinMap}" />
          <TextBlock Foreground="#203955" FontSize="15" Text="Jakarta" />
        </StackPanel>
        <TextBlock Foreground="#45596F" FontSize="10"  Text="{Binding CurrentTime^}" />
      </StackPanel>

      <weatherapp:Card Margin="5 10 10 10" Padding="10 0">

        <StackPanel Spacing="2" >

          <StackPanel Spacing="20" HorizontalAlignment="Left" Margin="10 0 0 0" VerticalAlignment="Center" Orientation="Horizontal">
            <Image 
              Source="avares://WeatherApp/Assets/Icons/partly_cloudy.png"
              Width="220"
              Height="180"
              Stretch="Uniform"
            />
            <StackPanel VerticalAlignment="Center" Spacing="6" HorizontalAlignment="Center">
                <StackPanel 
                  Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                  <TextBlock Text="28" Foreground="#45596F" FontWeight="SemiBold" FontSize="40" />
                  <TextBlock Text="℃" Foreground="#45596F" FontWeight="SemiBold" FontSize="20" Margin="4 0 0 0 " />
                </StackPanel>
                <TextBlock TextAlignment="Center" Text="Partly Cloud" Foreground="#45596F" FontSize="20" />
                <TextBlock Text="Feels like 28°" TextAlignment="Center" FontWeight="Light" Foreground="#45596F" FontSize="12" />
            </StackPanel>
          </StackPanel>

          <Grid ColumnSpacing="8" ColumnDefinitions="*,*,*" Margin="0 0 0 20">
            <StackPanel Spacing="5" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <PathIcon Height="20" Width="20" Foreground="#45596F" Data="{StaticResource IconHumidity}" />
              <StackPanel Margin="3 0 0 0">
                  <TextBlock Text="Humidity" FontWeight="Light" Foreground="#45596F" FontSize="10" />
                  <TextBlock Text="78%" Foreground="#45596F" FontSize="14" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="5" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <PathIcon Height="20" Width="20" Foreground="#45596F" Data="{StaticResource IconWind}" />
              <StackPanel Margin="3 0 0 0">
                  <TextBlock Text="Wind" FontWeight="Light" Foreground="#45596F" FontSize="10" />
                  <TextBlock Text="12 km/h" Foreground="#45596F" FontSize="14" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="5" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
              <PathIcon Height="20" Width="20" Foreground="#45596F" Data="{StaticResource IconPressure}" />
              <StackPanel Margin="3 0 0 0">
                  <TextBlock Text="Pressure" FontWeight="Light" Foreground="#45596F" FontSize="10" />
                  <TextBlock Text="1012 hPa" Foreground="#45596F" FontSize="14" />
              </StackPanel>
            </StackPanel>

          </Grid>
        </StackPanel>


      </weatherapp:Card>

    </StackPanel>
</UserControl>
