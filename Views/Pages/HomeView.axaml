<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WeatherApp.ViewModels.Pages"
             xmlns:weatherapp="using:WeatherApp"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WeatherApp.Views.Pages.HomeView"
             x:DataType="vm:HomeViewModel">

    <StackPanel Spacing="10">

      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Foreground="#203955" 
            Height="15" Width="15" 
            Data="{StaticResource IconPinMap}" />
          <TextBlock Foreground="#203955" FontSize="15" Text="Jakarta" />
        </StackPanel>
        <TextBlock Foreground="#45596F" FontSize="10"  Text="{Binding CurrentTime^}" />
      </StackPanel>

      <weatherapp:Card>
        <StackPanel Orientation="Horizontal">
          <Image 
            Source="avares://WeatherApp/Assets/Icons/cloudy_night.png"
            Width="120"
            Height="120"
            Stretch="Uniform"
          />
        </StackPanel>
      </weatherapp:Card>

    </StackPanel>
</UserControl>
