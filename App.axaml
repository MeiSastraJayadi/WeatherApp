<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WeatherApp.App"
             xmlns:local="using:WeatherApp"
             xmlns:converters="using:WeatherApp.Converters"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://WeatherApp/Views/Components/Card/Card.axaml"/>
                <ResourceInclude Source="avares://WeatherApp/Views/Components/SideBar/SideBarTheme.axaml"/>
                <ResourceInclude Source="avares://WeatherApp/Views/Components/NavButton/NavButton.axaml"/>
                <ResourceInclude Source="avares://WeatherApp/Views/Components/WeatherList/WheatherList.axaml"/>
                <ResourceInclude Source="avares://WeatherApp/Views/Components/Icons/Icon.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:EnumConverter x:Key="EnumEqualsConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>